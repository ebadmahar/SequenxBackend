PROJECT_NAME="Business Portal API"
PROJECT_DESCRIPTION="FastAPI Backend for Blog, Careers, Applications, and Contact Management"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database (SQLite file: ./app.db; switch to PostgreSQL by changing this URL)
DATABASE_URL="sqlite:///./app.db"

# Security & JWT
SECRET_KEY="change-this-in-production-to-a-very-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin User Seed
FIRST_ADMIN_NAME="Super Administrator"
FIRST_ADMIN_EMAIL="admin@example.com"
FIRST_ADMIN_PASSWORD="AdminPassword123!"

# Fallback HR Notification Email (can also be overridden in Site Settings)
HR_EMAIL="hr@example.com"

# SMTP Email Configuration
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="smtp-user"
SMTP_PASSWORD="smtp-password"
SMTP_FROM_EMAIL="no-reply@example.com"
SMTP_FROM_NAME="Company Careers & Blog"
SMTP_TLS=True

# Upload Directories & Limits
UPLOAD_DIR="uploads"
MAX_CV_SIZE_MB=5
MAX_IMAGE_SIZE_MB=3

# CORS Origins (comma separated - add your frontend domains here)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000,https://sequenxx.ebadmahar.site"
